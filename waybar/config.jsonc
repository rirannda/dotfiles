{
  "layer": "top",
  "position": "top",
  "height": 24, // Waybar height (to be removed for auto height)
  "spacing": 0, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [
    "custom/media-prev",
    "custom/media-play",
    "custom/media-next",
    "custom/media-title",
    "hyprland/window",
    "cpu",
    "temperature",
    "memory",
    "network",
  ],
  "modules-right": [
    "custom/ROG",
    "custom/bt",
    "tray",
    "pulseaudio",
    "backlight",
    "battery",
    "clock",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 6,
    },
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
    },
  },
  "hyprland/window": {
    "min-length": 30,
    "max-length": 30,
    "format": "{}",
    "rewrite": {
      "": "Hyprland",
    },
  },
  "clock": {
    "timezone": "Asia/Tokyo",
    "format": "{:%Y/%m/%d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M}",
  },
  "cpu": {
    "min-length": 20,
    "max-length": 20,
    "interval": 5,
    "format": "{avg_frequency}GHz / {usage}% ",
    "tooltip": false,
  },
  "memory": {
    "min-length": 20,
    "max-length": 20,
    "format": "{used:0.1f}GiB / {total:0.1f}GiB ",
    "interval": 10,
  },
  "temperature": {
    "min-length": 8,
    "max-length": 8,
    "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon5/temp1_input",
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""],
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["󱃍", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "network": {
    "format-wifi": "{icon}  ",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰀂 {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "format-alt": "󱛇",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{icon}   {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/waybar/scripts/wifi.sh &",
    "on-click-right": "~/.config/waybar/scripts/wifinew.sh &",
    "interval": 5,
    "nospacing": 1,
  },
  "tray": {
    "icon-size": 11,
    "spacing": 8,
  },
  "pulseaudio": {
    "format": "{volume}% {icon} ",
    "format-bluetooth": "{volume}% {icon}",
    "format-bluetooth-muted": " {icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "tooltip": false,
  },
  "custom/fanmode": {
    "exec": "~/.config/waybar/scripts/fanmode.sh",
    "interval": 1,
    "format": " {}",
    "on-click": "~/.config/waybar/scripts/fanmode.sh --toggle",
    "tooltip": false,
  },
  "custom/ROG": {
    "format": "ROG",
    "on-click": "rog-control-center",
  },
  "custom/bt": {
    "format": "",
    "tooltip": false,
    "on-click": "blueman-manager",
  },
  "custom/media-prev": {
    "exec": "~/.config/waybar/scripts/mediaplayer-prev.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "format": "{}",
    "on-click": "playerctl previous && pkill -RTMIN+8 waybar",
    "tooltip": false,
  },
  "custom/media-play": {
    "exec": "~/.config/waybar/scripts/mediaplayer-status.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "format": "{}",
    "on-click": "playerctl play-pause && pkill -RTMIN+8 waybar",
    "tooltip": false,
  },
  "custom/media-next": {
    "exec": "~/.config/waybar/scripts/mediaplayer-next.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "format": "{}",
    "on-click": "playerctl next && pkill -RTMIN+8 waybar",
    "tooltip": false,
  },
  "custom/media-title": {
    "exec": "~/.config/waybar/scripts/mediaplayer.py",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "max-length": 50,
    "format": "{}",
    "tooltip": true,
  },
}
